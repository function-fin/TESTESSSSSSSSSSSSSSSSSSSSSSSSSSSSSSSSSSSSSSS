local function AppendMessage(senderName, displayName, text, isMe, isPrivate)
    if mutedPlayers[senderName] and not isMe then return end

    local MsgLabel = Instance.new("TextLabel")
    MsgLabel.Size = UDim2.new(1, 0, 0, 0)
    MsgLabel.AutomaticSize = Enum.AutomaticSize.Y
    MsgLabel.BackgroundTransparency = 1
    MsgLabel.BorderSizePixel = 0
    MsgLabel.RichText = true
    MsgLabel.Font = Enum.Font.GothamMedium
    MsgLabel.TextSize = 16
    MsgLabel.TextWrapped = true
    MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
    MsgLabel.TextYAlignment = Enum.TextYAlignment.Top
    MsgLabel.TextTransparency = 0
    MsgLabel.TextStrokeTransparency = 1
    MsgLabel.Parent = MessagesArea

    MsgLabel:GetPropertyChangedSignal("TextTransparency"):Connect(function()
        if MsgLabel.TextTransparency > 0 then
            MsgLabel.TextTransparency = 0
        end
    end)

    task.spawn(function()
        for i = 1, 5 do
            task.wait(0.1)
            if MsgLabel and MsgLabel.Parent then
                MsgLabel.TextTransparency = 0
            end
        end
    end)

    local safeName = EscapeRichText(displayName or senderName)
    local safeMsg  = EscapeRichText(text)

    local nameColor = isMe and "rgb(80,220,120)" or "rgb(50,160,255)"
    local prefix = ""

    if isPrivate then
        if isMe then
            prefix = string.format("<font color='rgb(255,100,200)'>[TO: %s]</font> ", safeName)
        else
            prefix = "<font color='rgb(255,100,200)'>[PV]</font> "
        end
    end

    MsgLabel.Text = string.format(
        "%s<font color='%s'>[%s]:</font> <font color='rgb(255,255,255)'>%s</font>",
        prefix, nameColor, safeName, safeMsg
    )

    local ClickDetector = Instance.new("TextButton")
    ClickDetector.Size = UDim2.new(1, 0, 1, 0)
    ClickDetector.BackgroundTransparency = 1
    ClickDetector.Text = ""
    ClickDetector.ZIndex = 5
    ClickDetector.Parent = MsgLabel

    ClickDetector.MouseButton1Click:Connect(function()
        if isMe and not isPrivate then return end
        if ChatSettings.CopyText then
            if setclipboard then setclipboard(text)
            elseif toclipboard then toclipboard(text) end
            MsgLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            task.delay(0.2, function()
                if MsgLabel and MsgLabel.Parent then
                    MsgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
            end)
        else
            if not isMe then
                SetPrivateTarget(senderName)
            end
        end
    end)

    if not messagesByUser[senderName] then messagesByUser[senderName] = {} end
    table.insert(messagesByUser[senderName], MsgLabel)

    task.defer(function()
        if MessagesArea and MessagesArea.Parent then
            MessagesArea.CanvasPosition = Vector2.new(0, MessagesArea.AbsoluteCanvasSize.Y)
        end
    end)
end

local socket
local running = true

local function ConnectWS()
    if not running then return end
    local ok, res = pcall(function() return WebSocket.connect(WS_URL) end)

    if ok and res then
        socket = res
        print("[PrivateChat] Conectado ao PieHost.")

        socket.OnMessage:Connect(function(raw)
            if not running then return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if not (ok2 and data and data.message) then return end
            if data.serverId ~= CURRENT_SERVER_ID then return end

            local isMe = (data.username == LocalPlayer.Name)
            local isTargetingMe = (data.target == LocalPlayer.Name)
            local isPrivate = (data.target ~= nil and data.target ~= "")

            if isPrivate and not isTargetingMe and not isMe then return end
            if not isMe and IsDuplicate(data.username, data.message) then return end
            if mutedPlayers[data.username] and not isMe then return end

            if not isMe then
                AppendMessage(data.username, data.nickname or data.username, data.message, false, isPrivate)
                ShowBubble(data.username, data.message)

                if not MainPanel.Visible and ChatSettings.Notifications then
                    local plr = Players:FindFirstChild(data.username)
                    local uid = plr and plr.UserId or 0
                    if uid == 0 then
                        pcall(function() uid = Players:GetUserIdFromNameAsync(data.username) end)
                    end
                    ShowNotification(data.nickname or data.username, data.message, uid)
                end
            end
        end)

        socket.OnClose:Connect(function()
            if running then
                warn("[PrivateChat] Desconectado. Reconectando...")
                task.wait(5); ConnectWS()
            end
        end)
    else
        warn("[PrivateChat] Falha. Tentando novamente...")
        task.wait(5); ConnectWS()
    end
end

local function SendMessage()
    local content = ChatInput.Text

    if content:match("^%s*$") then return end

    content = CleanInvisibleChars(content)
    if content:match("^%s*$") then return end

    if string.lower(content) == "/clear" then
        for _, child in ipairs(MessagesArea:GetChildren()) do
            if child:IsA("TextLabel") then
                child:Destroy()
            end
        end
        ChatInput.Text = ""
        return
    end

    local currentTime = os.clock()
    if currentTime - lastMessageTime < COOLDOWN_TIME then
        ChatInput.TextColor3 = Color3.fromRGB(255, 100, 100)
        task.delay(0.3, function()
            if ChatInput then ChatInput.TextColor3 = COLORS.White end
        end)
        return
    end

    if not socket then warn("[PrivateChat] Sem conexão."); return end

    lastMessageTime = currentTime
    ChatInput.Text = ""

    local payload = {
        username = LocalPlayer.Name,
        nickname = LocalPlayer.DisplayName,
        message = content,
        serverId = CURRENT_SERVER_ID,
        target = currentPrivateTarget
    }
    pcall(function() socket:Send(HttpService:JSONEncode(payload)) end)

    AppendMessage(LocalPlayer.Name, LocalPlayer.DisplayName, content, true, currentPrivateTarget ~= nil)
    ShowBubble(LocalPlayer.Name, content)
end

ChatInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SendMessage()
    end
end)

