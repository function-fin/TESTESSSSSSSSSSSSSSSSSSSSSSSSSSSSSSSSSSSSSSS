local function HideNotification()
    if currentNotifTask then
        task.cancel(currentNotifTask)
        currentNotifTask = nil
    end
    NotificationFrame.Visible = false
end

local function ShowNotification(senderName, message, userId)
    if not ChatSettings.Notifications then return end

    if currentNotifTask then
        task.cancel(currentNotifTask)
        currentNotifTask = nil
    end

    NotificationSound:Play()

    NotifName.Text = EscapeRichText(senderName)
    NotifText.Text = EscapeRichText(message)
    NotifAvatar.Image = GetThumbnail(userId)

    NotificationFrame.Visible = true
    NotificationFrame.BackgroundTransparency = 0.05
    NotifName.TextTransparency = 0
    NotifText.TextTransparency = 0
    NotifAvatar.ImageTransparency = 0

    currentNotifTask = task.delay(2, function()
        TweenService:Create(NotificationFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(NotifName, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        TweenService:Create(NotifText, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        TweenService:Create(NotifAvatar, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
        task.wait(0.3)
        NotificationFrame.Visible = false
        currentNotifTask = nil
    end)
end

