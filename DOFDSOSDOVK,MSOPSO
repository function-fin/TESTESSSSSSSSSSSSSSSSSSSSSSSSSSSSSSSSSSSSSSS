local toggleBtnPressed = false

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        toggleBtnPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        if toggleBtnPressed then
            toggleBtnPressed = false
            local mousePos = input.Position
            local btnPos = ToggleButton.AbsolutePosition
            local btnSize = ToggleButton.AbsoluteSize
            if mousePos.X >= btnPos.X and mousePos.X <= btnPos.X + btnSize.X and
               mousePos.Y >= btnPos.Y and mousePos.Y <= btnPos.Y + btnSize.Y then
                MainPanel.Visible = not MainPanel.Visible
                if MainPanel.Visible then
                    HideNotification()
                end
            end
        end
    end
end)

